{
  "name": "@dao-style-viz/dashboard-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:ipavo-live-backend": "node scripts/check-ipavo-live-backend.mjs",
    "check:ipavo-live-pilot": "node scripts/check-ipavo-live-pilot.mjs",
    "check:roadmap-completion": "node scripts/check-roadmap-completion.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
