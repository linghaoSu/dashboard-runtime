{
  "name": "@dao-style-viz/product-integration-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "pnpm --filter @dao-style-viz/ai-dashboard-schema build && pnpm --filter @dao-style-viz/ai-dashboard-runtime build && pnpm --filter @dao-style-viz/ai-dashboard-ai-catalog build && pnpm --filter @dao-style-viz/ai-dashboard-vue build && pnpm --filter @dao-style-viz/ai-dashboard-widgets build && pnpm --filter @dao-style-viz/ai-dashboard-echarts-vue build",
    "predev": "pnpm run build:deps",
    "dev": "vite --host 127.0.0.1 --port 5174",
    "prebuild": "pnpm run build:deps",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "pretest": "pnpm run build:deps",
    "test": "vitest run src/__tests__"
  },
  "dependencies": {
    "@dao-style-viz/ai-dashboard-ai-catalog": "workspace:*",
    "@dao-style-viz/ai-dashboard-echarts-vue": "workspace:*",
    "@dao-style-viz/ai-dashboard-runtime": "workspace:*",
    "@dao-style-viz/ai-dashboard-schema": "workspace:*",
    "@dao-style-viz/ai-dashboard-vue": "workspace:*",
    "@dao-style-viz/ai-dashboard-widgets": "workspace:*",
    "@daocloud-proto/ipavo": "0.13.0",
    "vue": "3.3.13",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vue-tsc": "^2.2.12"
  }
}
